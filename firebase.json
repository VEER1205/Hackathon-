{
  "hosting": {
    "site": "futuro-ai",
    "public": "frontend",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/chatbot",
        "destination": "/chatbot.html"
      },
      {
        "source": "/chatbot/",
        "destination": "/chatbot.html"
      },
      {
        "source": "/psychometiric_test",
        "destination": "/test.html"
      },
      {
        "source": "/psychometiric_test/",
        "destination": "/test.html"
      },
      {
        "source": "/login",
        "destination": "/login.html"
      },
      {
        "source": "/login/",
        "destination": "/login.html"
      },
      {
        "source": "/",
        "destination": "/index.html"
      }
    ]
  }
}
